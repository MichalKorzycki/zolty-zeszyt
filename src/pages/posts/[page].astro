---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EntriesOne from "../../components/entries/EntriesOne.astro";
import Hero from "../../components/landing/Hero.astro";
import { getSortedPosts, getAllTags, PAGE_SIZE } from "../../utils/posts";

export async function getStaticPaths({ paginate }) {
  const sortedPosts = await getSortedPosts();
  return paginate(sortedPosts, { pageSize: PAGE_SIZE });
}

const { page } = Astro.props;
const sortedPosts = await getSortedPosts();
const tags = getAllTags(sortedPosts);

---

<BaseLayout>
  <Hero />
  <section>
    <div class="px-8 md:px-12 mx-auto max-w-7xl py-12 lg:px-32">
      <ol role="list" class="flex flex-wrap gap-3">
        {
          tags.map((tag) => (
            <li class="inline-flex items-center uppercase mx-auto hover:text-blue-500 text-xs font-medium text-black">
              <a href={`/tags/${tag}`}>{tag}</a>
            </li>
          ))
        }
      </ol>
      <ul
        class="grid grid-cols-1 mt-12 gap-1 gap-y-24 lg:grid-cols-3 sm:grid-cols-2"
      >
        {
          page.data.map((post) => (
            <EntriesOne
              url={"/posts/" + post.slug}
              title={post.data.title}
              description={post.data.description}
              alt={post.data.title}
              pubDate={post.data.pubDate.toISOString().split('T')[0]}
              author={post.data.author}
              image={post.data.image.url}
              tags={post.data.tags}
            />
          ))
        }
      </ul>
    </div>
  </section>
  <nav class="flex justify-center items-center gap-4 mt-12">
    {page.url.prev && <a href={page.url.prev} class="hover:text-blue-500">← Previous</a>}
    <span>Page {page.currentPage} of {page.lastPage}</span>
    {page.url.next && <a href={page.url.next} class="hover:text-blue-500">Next →</a>}
  </nav>

</BaseLayout>




