---
import { paginate,  getCollection } from 'astro:content'; // Assuming content collections

import BaseLayout from "../../layouts/BaseLayout.astro";
import EntriesOne from "../../components/entries/EntriesOne.astro";
import Hero from "../../components/landing/Hero.astro";

const allPosts = await getCollection("posts");
const tags = [...new Set(allPosts.map((post) => post.data.tags).flat())];
// Fetch your data (e.g., blog posts from content collections)
export async function getStaticPaths({ paginate }) {
  const allPosts = await getCollection("posts");
  const sortedPosts = allPosts.sort(
  (a, b) => new Date(b.data.pubDate) - new Date(a.data.pubDate)
).filter(entry => (entry.data.hidden !== true));
  
  return paginate(sortedPosts, { pageSize: 12 });
}

const { page } = Astro.props;

---

<BaseLayout>
  <Hero />
  <section>
    <div class="px-8 md:px-12 mx-auto max-w-7xl py-12 lg:px-32">
      <ol role="list" class="flex flex-wrap gap-3">
        {
          tags.map((tag) => (
            <li class="inline-flex items-center uppercase mx-auto hover:text-blue-500 text-xs font-medium text-black">
              <a href={`/tags/${tag}`}>{tag}</a>
            </li>
          ))
        }
      </ol>
      <ul
        class="grid grid-cols-1 mt-12 gap-1 gap-y-24 lg:grid-cols-3 sm:grid-cols-2"
      >
        {
          page.data.map((post) => (
            <EntriesOne
              url={"/posts/" + post.slug}
              title={post.data.title}
              description={post.data.description}
              alt={post.data.title}
              pubDate={post.data.pubDate.toString().slice(0, 10)}
              author={post.data.author}
              image={post.data.image.url}
              tags={post.data.tags}
            />
          ))
        }
      </ul>
    </div>
  </section>
  <nav class="flex justify-center items-center gap-4 mt-12">
    {page.url.prev && <a href={page.url.prev} class="hover:text-blue-500">← Previous</a>}
    <span>Page {page.currentPage} of {page.lastPage}</span>
    {page.url.next && <a href={page.url.next} class="hover:text-blue-500">Next →</a>}
  </nav>

</BaseLayout>




